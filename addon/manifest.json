{
  "manifest_version": 2,
  "name": "Sieve Buddy",
  "version": "0.5.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "HyperCriSiS",
  "browser_specific_settings": {
    "gecko": {
      "id": "proton-sieve-manager@hypercrisis.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "messagesRead",
    "menus",
    "https://mail.proton.me/*",
    "https://mail-api.proton.me/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "manager/manager.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Sieve Buddy",
    "default_icon": "icons/icon.svg"
  },
  "message_display_action": {
    "default_title": "__MSG_messageActionTitle__",
    "default_label": "__MSG_messageActionTitle__",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "optional_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
