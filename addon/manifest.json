{
  "manifest_version": 2,
  "name": "Proton Sieve Manager",
  "version": "0.1.0",
  "description": "Proton-Mail-Sieve-Filter direkt in Thunderbird verwalten – mit Syntax-Highlighting, Autovervollständigung und Prüfung.",
  "author": "HyperCriSiS",
  "browser_specific_settings": {
    "gecko": {
      "id": "proton-sieve-manager@hypercrisis.local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "https://mail.proton.me/*",
    "https://mail-api.proton.me/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.proton.me/api/core/v4/captcha*",
        "https://mail-api.proton.me/core/v4/captcha*"
      ],
      "js": [
        "captcha-relay.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "options_ui": {
    "page": "manager/manager.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Proton Sieve",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  }
}
