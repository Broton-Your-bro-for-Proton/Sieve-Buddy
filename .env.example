# Pflicht: Token für Weboberfläche, REST-API und MCP (mind. 24 Zeichen), z. B. `openssl rand -hex 32`
API_TOKEN=

# Optional: eigener Schlüssel für die verschlüsselte Proton-Sitzung in /data (Standard: API_TOKEN)
SESSION_SECRET=

# Optional: Schreibzugriffe (Filter anlegen/ändern/löschen) verbieten
ALLOW_WRITE=true

# Optional: Proton-API und App-Kennung
PROTON_API_BASE=https://mail.proton.me/api
PROTON_APP_VERSION=Other

# Optional
PORT=8080
