# Required: token for web UI, REST API and MCP (at least 24 characters), e.g. `openssl rand -hex 32`
API_TOKEN=

# Optional: separate key for the encrypted Proton session in /data (default: API_TOKEN)
SESSION_SECRET=

# Language of the web UI, messages and MCP descriptions: en (default) or de
LOCALE=en

# Provider: proton (Proton Mail), managesieve (Dovecot, Stalwart, Cyrus, mailbox.org, Mailcow …) or jmap (JMAP for Sieve, e.g. Stalwart)
PROVIDER=proton

# --- only with PROVIDER=managesieve ---
# MANAGESIEVE_HOST=mail.example.com
# MANAGESIEVE_PORT=4190
# MANAGESIEVE_TLS=starttls          # starttls (default), tls or none (only in your own network)
# MANAGESIEVE_USER=me@example.com
# MANAGESIEVE_PASSWORD=…            # or MANAGESIEVE_PASSWORD_FILE=/run/secrets/sieve
# MANAGESIEVE_INSECURE=false        # true = accept a self-signed certificate
# MANAGESIEVE_SASL=auto             # auto = SCRAM when offered, else PLAIN; plain if SCRAM fails with the right password
# Folder list via IMAP (default: same host, port 993, same credentials); empty IMAP_HOST= turns it off
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_TLS=tls
# IMAP_USER=me@example.com          # default: MANAGESIEVE_USER
# IMAP_PASSWORD=…                   # default: MANAGESIEVE_PASSWORD

# --- only with PROVIDER=jmap ---
# JMAP_URL=https://mail.example.com/.well-known/jmap
# JMAP_TOKEN=…                      # or JMAP_TOKEN_FILE=/run/secrets/jmap
# JMAP_USER=me@example.com          # set: user + token as password (Basic); empty: bearer token

# --- only with PROVIDER=proton ---
# Password login in the service (off by default; hand the session over from the Thunderbird add-on via “Hand over to service”)
ALLOW_PASSWORD_LOGIN=false

# Optional: forbid write access (creating, changing, deleting filters)
ALLOW_WRITE=true

# Optional: Proton API and app identifier
PROTON_API_BASE=https://mail.proton.me/api
PROTON_APP_VERSION=Other

# Optional: additional origins that may hand over a session (the Thunderbird add-on is always allowed)
CORS_ORIGINS=

# Optional
PORT=8080
# HOST=0.0.0.0                      # address the service listens on
# DATA_DIR=./data                   # where the session is stored (/data in the container)
