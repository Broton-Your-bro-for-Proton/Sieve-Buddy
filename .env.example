# Pflicht: Token für Weboberfläche, REST-API und MCP (mind. 24 Zeichen), z. B. `openssl rand -hex 32`
API_TOKEN=

# Optional: eigener Schlüssel für die verschlüsselte Proton-Sitzung in /data (Standard: API_TOKEN)
SESSION_SECRET=

# Sprache für Weboberfläche, Meldungen und MCP-Beschreibungen: de (Standard) oder en
LOCALE=de

# Anbieter: proton (Proton Mail), managesieve (Dovecot, Stalwart, Cyrus, mailbox.org, Mailcow …) oder jmap (JMAP for Sieve, z. B. Stalwart)
PROVIDER=proton

# --- nur bei PROVIDER=managesieve ---
# MANAGESIEVE_HOST=mail.example.com
# MANAGESIEVE_PORT=4190
# MANAGESIEVE_TLS=starttls          # starttls (Standard), tls oder none (nur im eigenen Netz)
# MANAGESIEVE_USER=ich@example.com
# MANAGESIEVE_PASSWORD=…            # oder MANAGESIEVE_PASSWORD_FILE=/run/secrets/sieve
# MANAGESIEVE_INSECURE=false        # true = selbstsigniertes Zertifikat akzeptieren
# Ordnerliste per IMAP (Standard: gleicher Host, Port 993, gleiche Zugangsdaten); IMAP_HOST= leer = aus
# IMAP_HOST=mail.example.com
# IMAP_PORT=993
# IMAP_TLS=tls

# --- nur bei PROVIDER=jmap ---
# JMAP_URL=https://mail.example.com/.well-known/jmap
# JMAP_TOKEN=…                      # oder JMAP_TOKEN_FILE=/run/secrets/jmap
# JMAP_USER=ich@example.com         # gesetzt: Benutzer + Token als Passwort (Basic); leer: Bearer-Token

# --- nur bei PROVIDER=proton ---
# Passwort-Login im Dienst (Standard aus – Sitzung im Thunderbird-Add-on per „An Dienst übergeben“ übertragen)
ALLOW_PASSWORD_LOGIN=false

# Optional: Schreibzugriffe (Filter anlegen/ändern/löschen) verbieten
ALLOW_WRITE=true

# Optional: Proton-API und App-Kennung
PROTON_API_BASE=https://mail.proton.me/api
PROTON_APP_VERSION=Other

# Optional: weitere Ursprünge, die eine Sitzung übergeben dürfen (das Thunderbird-Add-on ist immer erlaubt)
CORS_ORIGINS=

# Optional
PORT=8080
