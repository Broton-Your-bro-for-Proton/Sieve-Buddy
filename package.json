{
  "name": "proton-sieve-thunderbird",
  "version": "0.5.5",
  "private": true,
  "description": "Sieve filter manager: Thunderbird add-on and Docker/MCP service for Proton and ManageSieve servers",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "web-ext lint --source-dir addon",
    "build": "web-ext build --source-dir addon --artifacts-dir dist --overwrite-dest",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server",
    "docker:build": "docker build -t proton-sieve-service .",
    "fake-proton": "node scripts/fake-proton.mjs",
    "preview": "node scripts/serve.mjs",
    "fake-managesieve": "node scripts/fake-managesieve.mjs",
    "fake-jmap": "node scripts/fake-jmap.mjs",
    "dovecot:up": "docker build -t sieve-test-dovecot test/dovecot && docker run -d --name sieve-dovecot -p 127.0.0.1:14190:4190 -p 127.0.0.1:10993:993 sieve-test-dovecot",
    "stalwart:up": "docker run -d --name sieve-stalwart -e STALWART_RECOVERY_ADMIN=admin:test12345 -p 127.0.0.1:18480:8080 stalwartlabs/stalwart:v1.0.3"
  },
  "devDependencies": {
    "bcryptjs": "2.4.3",
    "codemirror": "5.65.18",
    "web-ext": "10.8.0"
  }
}
