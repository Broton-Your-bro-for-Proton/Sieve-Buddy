{
  "name": "proton-sieve-thunderbird",
  "version": "0.2.0",
  "private": true,
  "description": "Thunderbird add-on to manage Proton Mail Sieve filters",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "test": "node --test test/*.test.mjs",
    "lint": "web-ext lint --source-dir addon",
    "build": "web-ext build --source-dir addon --artifacts-dir dist --overwrite-dest",
    "test:server": "npm --prefix server test",
    "test:all": "npm test && npm run test:server",
    "docker:build": "docker build -t proton-sieve-service .",
    "fake-proton": "node scripts/fake-proton.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "bcryptjs": "2.4.3",
    "codemirror": "5.65.18",
    "web-ext": "8.3.0"
  }
}
